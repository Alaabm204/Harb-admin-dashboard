# ------------------------------------------------------------------
# harb-admin-dashboard — environment variable template
# Copy this file to ".env.local" and fill in real values.
# (.env.local is git-ignored; never commit real secrets.)
#
# NOTE (Next.js): only variables prefixed with NEXT_PUBLIC_ are
# exposed to the browser. Server-only secrets must NOT use it.
# ------------------------------------------------------------------

# Base URL of the app (used for absolute URLs, sitemap, etc.)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Upstream backend API consumed by the /api/proxy/* route.
# Server-side only — do NOT prefix with NEXT_PUBLIC_.
# The proxy falls back to its built-in default if this is unset.
ADMIN_API_BASE_URL=https://harb-group.vercel.app/api/v1

# NOTE: no API secret key is currently required — auth uses per-user
# tokens issued by the backend's login endpoint. If the backend team
# ever issues a service key, add it below WITHOUT the NEXT_PUBLIC_ prefix.
